rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "tournament_admin"];
    }

    function isSuperAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function notInMaintenance() {
      return !exists(/databases/$(database)/documents/config/app)
        || get(/databases/$(database)/documents/config/app).data.maintenanceMode != true;
    }

    function isValidTournament() {
      return request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.maxParticipants >= 2
        && request.resource.data.maxParticipants <= 64
        && request.resource.data.bracketType in ["single", "double"]
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.size() <= 3000;
    }

    function canJoinTournament() {
      return resource.data.published == true
        && request.time >= resource.data.regStart
        && request.time < resource.data.regEnd
        && resource.data.participants.size() < resource.data.maxParticipants
        && request.resource.data.participants.size() == resource.data.participants.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["participants", "participantNameSet"]);
    }

    // ── Kill switch ──────────────────────────────────

    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isSuperAdmin();
    }

    // ── Per-user rate limit counters ─────────────────

    match /rateLimits/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Registration Tokens ──────────────────────────

    match /registrationTokens/{tokenId} {
      allow read: if true;
      allow create: if request.auth != null && notInMaintenance() && (
        isAdmin()
        || (request.resource.data.tournamentId is string
            && get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.adminId == request.auth.uid)
      );
      allow update: if false;
      allow delete: if request.auth != null && isAdmin();
    }

    // ── Registration Entries ─────────────────────────

    match /registrationEntries/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null || (
        request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.tournamentId is string
        && request.resource.data.token is string
        && exists(/databases/$(database)/documents/registrationTokens/$(request.resource.data.token))
        && get(/databases/$(database)/documents/registrationTokens/$(request.resource.data.token)).data.tournamentId == request.resource.data.tournamentId
      );
      allow update: if false;
      allow delete: if request.auth != null && isAdmin();
    }

    // ── Bracket Share Tokens ─────────────────────────

    match /bracketTokens/{tokenId} {
      allow read: if true;
      allow create: if request.auth != null && notInMaintenance() && (
        isAdmin()
        || (request.resource.data.tournamentId is string
            && get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.adminId == request.auth.uid)
      );
      allow update: if false;
      allow delete: if request.auth != null && isAdmin();
    }

    // ── Tournaments ──────────────────────────────────

    match /tournaments/{tournamentId} {
      allow read: if resource.data.published == true
        || (request.auth != null
            && (resource.data.adminId == request.auth.uid || isAdmin()));
      allow create: if request.auth != null
        && notInMaintenance()
        && isAdmin()
        && isValidTournament();
      allow update: if request.auth != null
        && notInMaintenance()
        && (request.auth.uid == resource.data.adminId
            || canJoinTournament());
      allow delete: if request.auth != null
        && notInMaintenance()
        && request.auth.uid == resource.data.adminId;
    }

    // ── Users ────────────────────────────────────────

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && notInMaintenance()
        && (request.auth.uid == userId
            || (isAdmin()
                && request.resource.data.provider == "manual"
                && request.resource.data.role == "player"));
      allow update: if request.auth != null
        && notInMaintenance()
        && (request.auth.uid == userId
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["score"])
            || request.resource.data.diff(resource.data).affectedKeys().size() == 0);
      allow delete: if request.auth != null
        && notInMaintenance()
        && request.auth.uid == userId;
    }

    // ── Invites ──────────────────────────────────────

    match /invites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && notInMaintenance()
        && isAdmin();
      allow update: if request.auth != null
        && notInMaintenance()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usedCount", "used"]);
      allow delete: if false;
    }

    // ── Logs ─────────────────────────────────────────

    match /logs/{logId} {
      allow create: if request.auth != null
        && notInMaintenance()
        && request.resource.data.keys().size() <= 5;
      allow read: if false;
      allow delete: if false;
      allow update: if false;
    }
  }
}
